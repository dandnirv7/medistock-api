meta {
  name: 03. All OUT Movements
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/stock-movements?type=OUT&page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

query {
  type: OUT
  page: 1
  limit: 20
}

docs {
  Audit trail: semua stok keluar. Bisa filter by reason=SALE
  untuk penjualan, atau reason=DAMAGED untuk barang rusak.
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
