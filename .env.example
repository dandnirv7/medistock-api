# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Throttler ---------------------------------------------------------------
# Override the default per-minute request cap without changing code.
# Each env (development/production/test) has a sensible preset when unset
# (see src/app.module.ts). Useful for internal/demo deployments where the
# default 60/min production cap is too strict.
# THROTTLE_DEFAULT_LIMIT=10000
# THROTTLE_LOGIN_LIMIT=5
# THROTTLE_TEST_LIMIT=1000000

# --- Domain tuning ----------------------------------------------------------
# EXPIRED_SOON_DAYS — number of days from "today" within which a medicine is
# considered "expiring soon" (used by GET /medicines filters and the dashboard
# summary). Default 30. Useful for demo / QA to widen the window so the
# combined "low stock + soon" filter returns data.
# EXPIRED_SOON_DAYS=30

# --- Database ---------------------------------------------------------------
# Local PostgreSQL for the MVP. Used by Prisma (provider: postgresql).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medistock?schema=public

# --- Auth (JWT) -------------------------------------------------------------
# Slice 1 (Auth) will consume these. Listed here so the env is in place
# before the first run — Slice 0 does not validate them yet.
JWT_SECRET=change-me-in-real-env
JWT_EXPIRES_IN=1d

# --- API docs (Swagger) -----------------------------------------------------
# 1 = serve Swagger UI at GET /api/docs (default in dev, off in prod).
# 0 = hide the UI; /api/docs-json is still served for codegen / tools.
# Set explicitly per environment:
#   - dev/test: SWAGGER_ENABLED=1
#   - prod:     SWAGGER_ENABLED=0
SWAGGER_ENABLED=1

# --- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. In production
# this is a strict allowlist (no CORS_ORIGINS set = no cross-origin calls).
# In development the default is permissive (origin: true) so Flutter on
# the Android emulator (http://10.0.2.2:*) and web/desktop smoke tests on
# http://localhost:* work out of the box.
# Examples:
#   CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000
#   CORS_ORIGINS=https://medistock.app,https://admin.medistock.app
# Leave unset in development; set explicitly per environment in production.
# CORS_ORIGINS=
