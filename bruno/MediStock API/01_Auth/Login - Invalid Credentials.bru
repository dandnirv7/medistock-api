meta {
  name: Login - Invalid Credentials
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin",
    "password": "WRONG_PASSWORD"
  }
}

docs {
  Negative case: kredensial salah harus return 401 UNAUTHORIZED.
  Error envelope mengikuti docs/api_contract.md §4.2.
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });
  test("response success is false", function() {
    expect(res.body.success).to.equal(false);
  });
  test("error.code is UNAUTHORIZED", function() {
    expect(res.body.error.code).to.equal("UNAUTHORIZED");
  });
}
