meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Tablet",
    "description": "Obat berbentuk tablet"
  }
}

docs {
  Buat kategori baru. Setelah 201, ID otomatis tersimpan ke env var
  `testCategoryId` agar request berikutnya tinggal pakai.
}

script:post-response {
  if (res.status === 201 && res.body?.data?.id) {
    bru.setEnvVar("testCategoryId", res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("data.id is uuid", function() {
    expect(res.body.data.id).to.match(/^[0-9a-f-]{36}$/);
  });
  test("data.name is Tablet", function() {
    expect(res.body.data.name).to.equal("Tablet");
  });
}
