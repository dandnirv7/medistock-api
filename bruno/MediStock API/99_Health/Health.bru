meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

docs {
  Liveness check di GET /api/v1/health. Public (no auth). Harus return
  { status: "ok" } dengan status 200. Juga ada bare probe di GET /health
  (di luar prefix) — keduanya return shape identik.
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("body.status is ok", function() {
    expect(res.body.status).to.equal("ok");
  });
}
