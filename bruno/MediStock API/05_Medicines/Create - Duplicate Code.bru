meta {
  name: Create - Duplicate Code
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/medicines
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "code": "PAR-500",
    "name": "Duplikat Paracetamol",
    "categoryId": "{{testCategoryId}}",
    "supplierId": "{{testSupplierId}}",
    "unit": "Tablet",
    "purchasePrice": 250,
    "sellingPrice": 500,
    "minimumStock": 10
  }
}

docs {
  Negative case: code duplikat harus 409 DUPLICATE_RESOURCE.
}

tests {
  test("status is 409", function() {
    expect(res.status).to.equal(409);
  });
  test("error.code is DUPLICATE_RESOURCE", function() {
    expect(res.body.error.code).to.equal("DUPLICATE_RESOURCE");
  });
}
