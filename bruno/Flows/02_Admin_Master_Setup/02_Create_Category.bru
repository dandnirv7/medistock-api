meta {
  name: 02. Create Category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Tablet",
    "description": "Obat berbentuk tablet"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.id) {
    bru.setEnvVar("testCategoryId", res.body.data.id);
  }
}

docs {
  Setup awal: buat kategori. ID tersimpan otomatis ke `testCategoryId`.
  Ganti nama di body jika "Tablet" sudah ada dari run sebelumnya.
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("categoryId saved", function() {
    expect(bru.getEnvVar("testCategoryId")).to.match(/^[0-9a-f-]{36}$/);
  });
}
