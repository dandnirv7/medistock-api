# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Local PostgreSQL for the MVP. Used by Prisma (provider: postgresql).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medistock?schema=public

# --- Auth (JWT) -------------------------------------------------------------
# Slice 1 (Auth) will consume these. Listed here so the env is in place
# before the first run — Slice 0 does not validate them yet.
JWT_SECRET=change-me-in-real-env
JWT_EXPIRES_IN=1d

# --- API docs (Swagger) -----------------------------------------------------
# 1 = serve Swagger UI at GET /api/docs (default in dev, off in prod).
# 0 = hide the UI; /api/docs-json is still served for codegen / tools.
# Set explicitly per environment:
#   - dev/test: SWAGGER_ENABLED=1
#   - prod:     SWAGGER_ENABLED=0
SWAGGER_ENABLED=1
