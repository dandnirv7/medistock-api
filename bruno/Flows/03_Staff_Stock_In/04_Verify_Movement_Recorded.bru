meta {
  name: 04. Verify Movement Recorded
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/stock-movements?type=IN&medicineId={{testMedicineId}}&limit=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

query {
  type: IN
  medicineId: {{testMedicineId}}
  limit: 5
}

docs {
  Filter list mutasi by type=IN dan medicineId, harusnya ada movement
  dari step 03.
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("at least 1 IN movement", function() {
    expect(res.body.data).to.have.length.at.least(1);
  });
  test("latest is type IN", function() {
    expect(res.body.data[0].type).to.equal("IN");
  });
}
